+  a.chunks.length === 1 && a.chunks[0].frames === 2 && !a.stopped && b.stopped &&
+  b.frames === 5 && b.chunks.length === 2 && b.chunks[0].frames === 2 && b.chunks[1].frames === 1 &&
+  [...a.chunks, ...b.chunks].reduce((n, x) => n + x.bytes.length, 0) === 5 * WAV_FRAME_BYTES);
+
