diff --git a/tests/desert_ui_test.c b/tests/desert_ui_test.c
new file mode 100644
index 0000000..eee981c
--- /dev/null
+++ b/tests/desert_ui_test.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Actual firmware drawing: pitch readouts, note lifecycle, sample upload refresh. */
+#define UI_RENDER_NO_MAIN 1
+#include "ui_render.c"
+#include <assert.h>
+
+static int shown(const char *text)
+{
+    for (uint32_t i = 0; i < nscr; i++)
+        if (!strcmp(scr[i].s, text)) return 1;
+    return 0;
+}
+
+static void redraw_graph(void)
+{
+    nscr = npend = 0;
+    ui.force = 0;
+    draw_graph();
+}
+
+/* Partial redraws must retain the exact same pattern, including clipped edges
+ * and graph offsets. Otherwise the background crawls when a value changes. */
+static void check_pattern_redraw(void)
+{
+    uint16_t full[37 * 19];
+    setup(S_RAST); pal(UI_SARDAB_INDEX);
+    cv_oy = 3;
+    cv_begin(37, 19, T_BG);
+    cv_stone(-2, -5, 42, 28, 0, 0);
+    memcpy(full, cv_px, sizeof full);
+    cv_begin(37, 19, T_BG);
+    for (int x = -2; x < 40; x += 7)
+        for (int y = -5; y < 23; y += 4)
+            cv_stone(x, y, 7, 4, 0, 0);
+    assert(!memcmp(full, cv_px, sizeof full));
+    unsigned specks = 0;
+    for (unsigned i = 0; i < 37 * 19; i++) specks += full[i] == swap16(T_STONE);
+    assert(specks > 0 && specks < 37 * 19 / 8); /* sparse, visible, deterministic */
+    cv_oy = 0;
+}
+
+int main(void)
+{
+    check_pattern_redraw();
+    static const char *const third[12] = {"E", "F", "F#", "G", "G#", "A", "A#", "B", "C", "C#", "D", "D#"};
+    for (uint32_t root = 0; root < 12; root++) {
+        char want[24];
+        setup(S_TUNE2); pal(UI_SARDAB_INDEX);
+        TSEL->p[P_ROOT] = root;
+        snprintf(want, sizeof want, "%s -37 ct", third[root]);
+        draw(S_TUNE2);
+        assert(shown(want));                         /* effective preset + trim, transposed label */
+        assert(shown(third[root]));                  /* knob still edits its original relative trim */
+    }
+    setup(S_TUNE_TOTAL); pal(UI_SARDAB_INDEX); draw(S_TUNE_TOTAL);
+    assert(shown("F# -126.7 ct"));                   /* temperament precision retained */
+
+    setup(S_RAST); pal(UI_SARDAB_INDEX);
+    TSEL->p[P_VOICE] = V_POLY;
+    TSEL->engine = TSEL->eng_req;
+    memset(TSEL->v, 0, sizeof TSEL->v);
+    trk_note_on(TSEL, 60, 100); trk_note_on(TSEL, 67, 100); trk_note_on(TSEL, 64, 100);
+    draw(S_RAST);
+    assert(shown("E4 -50 ct") && shown("PLAY"));
+    assert((scale_playing(TSEL) & 4095u) == ((1u << 0) | (1u << 4) | (1u << 7)));
+    for (uint32_t i = 0; i < 12; i++) {
+        uint16_t pixel = host_screen[(graph_y() + GOY + 84) * 240u + 20 + i * 18];
+        assert((pixel == swap16(T_ACCENT)) == (i == 0 || i == 4 || i == 7));
+    }
+    trk_note_off(TSEL, 64);
+    redraw_graph(); assert(shown("G4 +0 ct"));       /* gate release redraws without UI force */
+    TSEL->p[P_MUTE] = 1;
+    redraw_graph(); assert(shown("C +0 ct") && shown("ROOT"));
+
+    setup(S_DESERT_MISSING); pal(UI_SARDAB_INDEX); draw(S_DESERT_MISSING);
+    assert(shown("LOADED") && shown("USR1 MISSING: SINE") && shown("NO SAMPLE"));
+    {
+        smp_user_hdr_t *h = (smp_user_hdr_t *)host_slots;
+        h->magic = SMP_USER_MAGIC; h->version = 1; h->nz = 1; h->data_len = 2;
+        memcpy(h->name, "DUNE TAR", 8);
+        h->zone[0] = (smp_zone_t){.n=4, .le=3, .rate=32768, .root16=960, .hi=127};
+        smp_user_scan(0);
+        redraw_graph(); assert(shown("DUNE TAR") && shown("USR1 READY"));
+        h->zone[0].rate = 0;                        /* invalid data must not be called ready */
+        smp_user_scan(0);
+        redraw_graph(); assert(shown("USR1 MISSING: SINE"));
+    }
+    setup(S_DESERT_OTHER); pal(UI_SARDAB_INDEX); draw(S_DESERT_OTHER);
+    assert(shown("NOT IN LIST") && !shown("LOADED"));
+    {
+        uint32_t total;
+        preset_pos(&total);
+        for (uint32_t i = 0; i < total; i++) {
+            preset_go(i); ui.msg_t = 0; ui.force = 1;
+            draw(S_DESERT);
+            assert(shown("LOADED"));
+        }
+    }
+    setup(S_LFO); pal(UI_SARDAB_INDEX); draw(S_LFO); assert(PANEL_W == 220);
+    setup(S_LFO); pal(UI_CRYPT_INDEX); draw(S_LFO); assert(PANEL_W == 220);
+    puts("desert UI: tuning, live notes, sample refresh, loaded state, torch-free panels and stable Bayer redraws passed");
+    return 0;
+}
diff --git a/tests/dream_maqam_test.c b/tests/dream_maqam_test.c
new file mode 100644
index 0000000..b83e9e1
--- /dev/null
+++ b/tests/dream_maqam_test.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* DREAM shares the selected maqam's pitch map, including Scala and user trims. */
+#define UI_TEST_NO_MAIN 1
+#include "ui_test.c"
+#include <assert.h>
+int main(void)
+{
+    unsigned pieces=0;
+    for(unsigned scl=0;scl<NELEM(SCALE_MASK);scl++) for(unsigned root=0;root<12;root++) {
+        ui_power_on(); song.sel=2;
+        for(unsigned t=0;t<NTRK;t++) { set_engine_of(&trk[t],0); engine_block(&trk[t]); apply_preset_to(&trk[t],0); }
+        TSEL->p[P_SCALE]=scl; TSEL->p[P_TEMP]=3;
+        TSEL->p[P_TC4]=13; TSEL->p[P_TC11]=-7;
+        TSEL->p[P_TMASK0]=0x15; TSEL->p[P_TMASK1]=0x24;
+        unsigned mask=scale_mask(TSEL); int16_t tune[15];
+        memcpy(tune,&TSEL->p[P_TC0],sizeof tune);
+        song.g[G_DMOOD]=6; dream_compose(root);
+        for(unsigned pass=0;pass<10;pass++) {
+            for(unsigned t=0;t<NTRK;t++) {
+                assert(trk[t].p[P_SCALE]==scl && trk[t].p[P_ROOT]==root);
+                assert(!memcmp(tune,&trk[t].p[P_TC0],sizeof tune));
+                for(unsigned k=0;k<NSTEP;k++) for(unsigned j=0;j<trk[t].step[k].n;j++) {
+                    unsigned n=trk[t].step[k].note[j], pc=(n+12-root)%12;
+                    assert(mask>>pc&1u);
+                    double cents=SCALE_CENTS[scl][pc]+tune[pc]+TEMPER[3][pc]/10.;
+                    double want=440.*pow(2.,((int)n-69+cents/100.)/12.);
+                    double got=cents_inc(tuning_pitch16(&trk[t],n),0,tuning_residual(&trk[t],n))*(double)FS/4294967296.;
+                    assert(fabs(1200.*log2(got/want))<0.5);
+                }
+            }
+            dream_evolve();
+        }
+        pieces++;
+    }
+    /* Empty custom scale remains bounded and produces a root, never divides by zero. */
+    TSEL->p[P_SCALE]=SCALE_CUSTOM_ID; TSEL->p[P_TMASK0]=TSEL->p[P_TMASK1]=0;
+    dream_compose(0); assert(dream.mask); dream_evolve();
+    /* Independent Rast pitches, then actual simultaneous oscillator phases of the generated notes. */
+    ui_power_on(); song.sel=0;
+    for(unsigned t=0;t<NTRK;t++) { set_engine_of(&trk[t],0); engine_block(&trk[t]); apply_preset_to(&trk[t],3); } /* ANALOG SINE KEY */
+    trk[0].p[P_SCALE]=16; trk[0].p[P_TC4]=13;
+    song.g[G_DMOOD]=6; dream_compose(0);
+    const unsigned notes[]={60,64,67,71}; const int cents[]={0,-37,0,-50};
+    for(unsigned t=0;t<NTRK;t++) { memset(trk[t].v,0,sizeof trk[t].v); trk[t].engine=trk[t].eng_req=0; trk[t].xf_on=0; trk[t].p[P_E1]=0; }
+    uint32_t phase[4]; voice_t *v[4]; int32_t audio[CTL];
+    for(unsigned i=0;i<4;i++) {
+        trk_note_on(&trk[i],notes[i],96); v[i]=0;
+        for(unsigned j=0;j<NVOICE;j++) if(trk[i].v[j].active && trk[i].v[j].note==notes[i])v[i]=&trk[i].v[j];
+        assert(v[i]); phase[i]=v[i]->ph[0];
+    }
+    for(unsigned i=0;i<4;i++) {
+        track_render(&trk[i],audio,CTL);
+        double got=(uint32_t)(v[i]->ph[0]-phase[i])*(double)FS/CTL/4294967296.;
+        double want=440.*pow(2.,((int)notes[i]-69+cents[i]/100.)/12.);
+        assert(fabs(1200.*log2(got/want))<0.5);
+    }
+    /* Full runtime save/restore of DREAM controls, RING and existing tuning. */
+    project_t q; project_store_t st;
+    song.g[G_DREAM]=1; song.g[G_DDENS]=8; song.g[G_DDRFT]=3; trk[0].p[P_RING]=1;
+    project_capture(&q); assert(proj_pack(&st,&q)); assert(proj_import(&q,&st,sizeof st));
+    song.g[G_DMOOD]=0; assert(project_restore_runtime(&q)==0);
+    assert(song.g[G_DREAM]==1 && song.g[G_DDENS]==8 && song.g[G_DDRFT]==3 && song.g[G_DMOOD]==6);
+    assert(trk[0].p[P_RING]==1 && trk[0].p[P_TC4]==13 && !dream.valid);
+    /* Reduced FM6 LUT: a full fractional octave sweep against the analytic function. */
+    double worst=0;
+    for(int32_t x=0;x<16777216;x+=127) {
+        double got=fm6_mant(x)/1073741824.,want=pow(2.,x/16777216.);
+        double err=fabs(1200.*log2(got/want)); if(err>worst)worst=err;
+    }
+    assert(worst<0.0001);
+    printf("DREAM: %u scale/tonic combinations x 10 evolutions; Scala, trims, polyphonic Rast, persistence; FM6 max error %.8f cents\n",pieces,worst);
+    return 0;
+}
diff --git a/tests/dream_test.c b/tests/dream_test.c
new file mode 100644
index 0000000..503f0f2
--- /dev/null
+++ b/tests/dream_test.c
@@ -0,0 +1,317 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 GHOULBOX (on Felucca by Leo Kuroshita, Hügelton Instruments) */
+/* DREAM (GHOULBOX 2.3: HOME > DREAM, dream.c) through the UI's own code (the UI test's harness):
+ * 1. the page (after KEYS on HOME's taps) and its four controls, saved with the project (FUN10's tail; none: defaults).
+ * 2. the parts by sound: the power-on scenes' tracks.
+ * 3. a piece, for every scene, MOOD and DENS 1 / 4 / 8: 64 steps at 1/8, ROOT and SCL set, every note in the key and in
+ *    range, a tie only after a note, the drone one note held, the pads triads, the drums hits, a GURDY's drones on the key.
+ * 4. DENS: more notes at 8 than at 1.
+ * 5. the keys on DREAM: silent; over steps the dialog first (its key), then a key composes at once.
+ * 6. EVOL: a change at the end of a pass (every pass at DRFT 8), always in key, the drone and the motif's span kept; none
+ *    with EVOL OFF, nor stopped. After a load, the key and the chords are found back from the tracks. */
+#define UI_TEST_NO_MAIN 1
+#include "ui_test.c"
+
+static int note_ok(uint32_t n)
+{
+    return n >= 24u && n <= 100u && ((SCALE_MASK[dream.scl] >> ((n + 120u - dream.root) % 12u)) & 1u);
+}
+
+/* the piece now on the tracks against what 3. asks; why not on stdout */
+static int piece_ok(const char *what)
+{
+    uint32_t i, j, k;
+    for (i = 0; i < NTRK; i++) {
+        const track_t *t = &trk[i];
+        uint32_t r = dream.role[i], drum = t->eng_req % NENGINES == ENGI_DRUM;
+        int prev = r == DR_PAD && dream.dup[i];            /* (a late pad's first steps tie over from the last chord) */
+        if (t->p[P_SLEN] != 64 || t->p[P_SDIV] != 1 || t->p[P_ROOT] != dream.root || t->p[P_SCALE] != dream.scl ||
+            t->p[P_CHRD] || t->p[P_AMODE]) {
+            printf("    %s: T%u's LEN DIV ROOT SCL CHRD ARP\n", what, i + 1u);
+            return 0;
+        }
+        if (t->eng_req % NENGINES == ENGI_GURDY && t->p[P_E0] != dream.root) {
+            printf("    %s: T%u's DRN\n", what, i + 1u);
+            return 0;
+        }
+        for (j = 0; j < 64u; j++) {
+            const step_t *s = &t->step[j];
+            if (s->time == ST_TIE && !prev) {
+                printf("    %s: T%u step %u ties onto nothing\n", what, i + 1u, j + 1u);
+                return 0;
+            }
+            if (s->time == ST_NOTE)
+                prev = 1;
+            else if (s->time == ST_REST)
+                prev = 0;
+            if (s->time != ST_NOTE)
+                continue;
+            if (drum ? s->n || !s->hit : !s->n || s->hit) {
+                printf("    %s: T%u step %u: notes %u hits %02x\n", what, i + 1u, j + 1u, s->n, s->hit);
+                return 0;
+            }
+            for (k = 0; k < s->n; k++)
+                if (!note_ok(s->note[k])) {
+                    printf("    %s: T%u step %u note %u out of key or range\n", what, i + 1u, j + 1u, s->note[k]);
+                    return 0;
+                }
+            if ((r == DR_PAD && s->n != 3u) || (r == DR_DRONE && j) || (r != DR_PAD && r != DR_DRONE && s->n > 1u)) {
+                printf("    %s: T%u (role %u) step %u holds %u notes\n", what, i + 1u, r, j + 1u, s->n);
+                return 0;
+            }
+        }
+    }
+    return 1;
+}
+
+static uint32_t notes_of(const track_t *t)
+{
+    uint32_t j, n = 0;
+    for (j = 0; j < 64u; j++)
+        n += t->step[j].time == ST_NOTE;
+    return n;
+}
+
+static void scene(uint32_t sc)
+{
+    ui_power_on();
+    gb_scene_load(sc);
+    song.playing = 0;
+    transport_req = 0;
+}
+
+int main(void)
+{
+    int bad = 0, ok;
+    uint32_t i, k, sc, m, d;
+    static const uint8_t ROLES[4][4] = {
+        {DR_MELODY, DR_PAD, DR_PAD, DR_DRONE},         /* DUNGEON: HURDY GURDY, CRYPT PAD, MONKS, DRONE WHEEL */
+        {DR_DRONE, DR_PAD, DR_DRONE, DR_PERC},         /* CRYPT: LOW DRONE, CRYPT CHOIR, CAVE WIND, TOMB DRUMS */
+        {DR_MELODY, DR_ARP, DR_ARP, DR_PERC},          /* TAVERN: DANCE GURDY, DUNGEON HARP, LUTE, CRYPT KIT */
+        {DR_PAD, DR_PAD, DR_MELODY, DR_HIGH},          /* CHAPEL: CATHEDRAL, MONKS, TENOR RECORD, VIELLE (2nd melody) */
+    };
+
+    /* 1 */
+    ui_power_on();
+    ui.home = 1;
+    for (k = 0; k < 4u; k++)
+        home_tap();
+    ok = !ui.home && str_eq(cur_page()->title, "DREAM") && cur_page()->fam == FAM_TRK && cur_page()->id[0] == G_DREAM &&
+         cur_page()->id[3] == G_DMOOD && str_eq(GP[G_DREAM].label, "EVOL") && str_eq(GP[G_DDENS].label, "DENS") &&
+         str_eq(GP[G_DDRFT].label, "DRFT") && str_eq(GP[G_DMOOD].label, "MOOD") && GP[G_DMOOD].max == 6 &&
+         GP[G_DREAM].def == 0 && GP[G_DDENS].def == 4 && GP[G_DDRFT].def == 6 && G_COUNT == 43;
+    bad += check("DREAM: HOME's fourth tap (after MIXER CLOCK KEYS), EVOL DENS DRFT MOOD", ok);
+    {
+        project_t q;
+        project_store_t st;
+        song.g[G_DREAM] = 1; song.g[G_DDENS] = 8; song.g[G_DDRFT] = 1; song.g[G_DMOOD] = 5;
+        project_capture(&q);
+        ok = proj_pack(&st, &q) == 1 && proj_import(&q, &st, (int)sizeof st) && q.dream == 656u;
+        st.raw[PROJ_DREAM_OFF] = st.raw[PROJ_DREAM_OFF + 1u] = 0;   /* a project saved before 2.3: no DREAM word */
+        k = proj_hash(st.raw, PROJ_STORE_SIZE - 4u);
+        memcpy(st.raw + PROJ_STORE_SIZE - 4u, &k, 4);
+        ok &= proj_import(&q, &st, (int)sizeof st) && q.dream == 0;
+        bad += check("  saved with the project; a project from before 2.3: EVOL OFF, DENS 4, DRFT 6, MAQAM", ok);
+    }
+
+    /* 2 */
+    for (ok = 1, sc = 0; sc < 4u; sc++) {
+        scene(sc);
+        dr_roles();
+        for (i = 0; i < NTRK; i++)
+            if (dream.role[i] != ROLES[sc][i]) {
+                printf("    scene %s T%u: role %u, not %u\n", GB_SCENES[sc].name, i + 1u, dream.role[i], ROLES[sc][i]);
+                ok = 0;
+            }
+    }
+    bad += check("the parts by sound: drone, pad (a second one later, higher), melody (a second one high), arp, drums", ok);
+
+    /* 3 */
+    for (ok = 1, sc = 0; sc < 4u && ok; sc++)
+        for (m = 0; m < 6u && ok; m++)
+            for (d = 1; d <= 8u && ok; d += d == 1u ? 3u : 4u)
+                for (k = 0; k < 3u && ok; k++) {
+                    char w[48];
+                    scene(sc);
+                    rng_state = 0x9E3779B9u * (sc * 97u + m * 13u + d * 5u + k + 1u);
+                    song.g[G_DMOOD] = (int16_t)m;
+                    song.g[G_DDENS] = (int16_t)d;
+                    dream_compose((sc * 5u + m * 7u + k) % 12u);
+                    snprintf(w, sizeof w, "%s %s DENS %u #%u", GB_SCENES[sc].name, N_DMOOD[m], d, k);
+                    ok = dream.valid && transport_req == 1u && piece_ok(w);
+                }
+    bad += check("pieces (4 scenes x 6 moods x DENS 1 4 8 x 3): 64 steps 1/8, in key and range, ties on notes", ok);
+
+    /* 4 */
+    {
+        uint32_t lo = 0, hi = 0;
+        for (k = 0; k < 8u; k++) {
+            scene(2);
+            song.g[G_DDENS] = 1; dream_compose(2); lo += notes_of(&trk[1]) + notes_of(&trk[0]);
+            scene(2);
+            song.g[G_DDENS] = 8; dream_compose(2); hi += notes_of(&trk[1]) + notes_of(&trk[0]);
+        }
+        bad += check("DENS: the arp and the melody play more at 8 than at 1", hi > lo * 3u / 2u);
+        printf("        (TAVERN's harp and gurdy: %u notes at DENS 1, %u at 8, over 8 pieces)\n", lo, hi);
+    }
+
+    /* 5 */
+    {
+        uint32_t key = 9;                              /* D4 (key 0 is F3) */
+        scene(0);
+        dream.asked = 0;
+        ui.home = 1;
+        for (k = 0; k < 4u; k++)
+            home_tap();
+        frame();
+        ok = song.grid == 4u;
+        fm1_in.notes |= 1u << key;
+        host_notes |= 1u << key;
+        frame();
+        events_block(CTL);
+        for (i = 0; i < NTRK; i++)
+            for (k = 0; k < NVOICE; k++)
+                ok &= !(trk[i].v[k].active && trk[i].v[k].gate);
+        ok &= ui.confirm == CF_DREAM && ui.confirm_trk == 2u;
+        fm1_in.notes &= ~(1u << key);
+        frame();
+        press(B_OCTUP);
+        ok &= !ui.confirm && dream.valid && dream.asked && dream.root == 2u && trk[0].p[P_ROOT] == 2;
+        tap_key(key + 2u);                             /* E4: at once, no dialog */
+        ok &= !ui.confirm && dream.root == 4u && trk[2].p[P_ROOT] == 4;
+        bad += check("the keys on DREAM: silent, the dialog over steps (its key), then a key composes at once", ok);
+    }
+
+    /* 6 */
+    {
+        static step_t before[NTRK][NSTEP];
+        uint32_t changes = 0, pass, motif_kept = 1, drone_kept = 1, inkey = 1;
+        int16_t mute[NTRK];
+        scene(0);
+        rng_state = 12345;
+        dream_compose(2);
+        song.g[G_DREAM] = 1;
+        song.g[G_DDRFT] = 8;                           /* every pass */
+        song.playing = 1;
+        for (pass = 0; pass < 60u; pass++) {
+            for (i = 0; i < NTRK; i++) {
+                memcpy(before[i], trk[i].step, sizeof before[i]);
+                mute[i] = trk[i].p[P_MUTE];
+            }
+            trk[0].seq_idx = 40;
+            dream_tick();
+            trk[0].seq_idx = 0;
+            dream_tick();
+            for (k = 0, i = 0; i < NTRK; i++)
+                k |= memcmp(before[i], trk[i].step, sizeof before[i]) || mute[i] != trk[i].p[P_MUTE];
+            changes += k;
+            for (i = 0; i < NTRK; i++) {
+                motif_kept &= dream.role[i] != DR_MELODY || !memcmp(before[i], trk[i].step, 16u * sizeof(step_t));
+                drone_kept &= dream.role[i] != DR_DRONE || !memcmp(before[i], trk[i].step, sizeof before[i]);
+            }
+            inkey &= piece_ok("EVOL");
+        }
+        bad += check("EVOL at DRFT 8: a change at every pass's end, in key; the drone and the motif's span kept",
+                     changes >= 55u && motif_kept && drone_kept && inkey);
+        printf("        (%u of 60 passes changed something)\n", changes);
+        for (i = 0; i < NTRK; i++)
+            memcpy(before[i], trk[i].step, sizeof before[i]);
+        song.g[G_DDRFT] = 6;                           /* every 3 passes */
+        for (changes = 0, pass = 0; pass < 30u; pass++) {
+            trk[0].seq_idx = 40; dream_tick(); trk[0].seq_idx = 0; dream_tick();
+            changes += memcmp(before[0], trk[0].step, sizeof before[0]) != 0;
+        }
+        song.g[G_DREAM] = 0;
+        for (i = 0; i < NTRK; i++)
+            memcpy(before[i], trk[i].step, sizeof before[i]);
+        for (pass = 0; pass < 30u; pass++) {
+            trk[0].seq_idx = 40; dream_tick(); trk[0].seq_idx = 0; dream_tick();
+        }
+        for (ok = 1, i = 0; i < NTRK; i++)
+            ok &= !memcmp(before[i], trk[i].step, sizeof before[i]);
+        song.g[G_DREAM] = 1;
+        song.playing = 0;
+        for (pass = 0; pass < 30u; pass++) {
+            trk[0].seq_idx = 40; dream_tick(); trk[0].seq_idx = 0; dream_tick();
+        }
+        for (i = 0; i < NTRK; i++)
+            ok &= !memcmp(before[i], trk[i].step, sizeof before[i]);
+        bad += check("  none with EVOL OFF, nor with the transport stopped", ok);
+    }
+    {
+        uint8_t deg[4];
+        scene(1);
+        rng_state = 777;
+        dream_compose(5);
+        memcpy(deg, dream.deg, 4);
+        dream.valid = 0;
+        dream.root = dream.scl = 0;
+        memset(dream.deg, 9, 4);
+        dr_rebuild();
+        bad += check("after a load: the key, the scale and the chords found back from the tracks",
+                     dream.valid && dream.root == 5u && dream.scl == trk[0].p[P_SCALE] && !memcmp(deg, dream.deg, 4));
+    }
+    {   /* 2.3.1 (Codex's review): a project loaded after a dream, then EVOL: its own key and parts, not the dream's; a sound
+         * load forgets the dream too */
+        project_t q;
+        uint32_t pass;
+        scene(1);                                      /* project A: CRYPT's sounds dreamed in A Phrygian */
+        song.g[G_DMOOD] = 2;
+        rng_state = 99;
+        dream_compose(9);
+        project_capture(&q);
+        scene(0);                                      /* then a dream in D on DUNGEON's sounds */
+        song.g[G_DMOOD] = 0;
+        dream_compose(2);
+        ok = dream.valid && dream.root == 2u;
+        project_restore_runtime(&q);                   /* load A */
+        ok &= !dream.valid;
+        song.g[G_DREAM] = 1; song.g[G_DDRFT] = 8; song.playing = 1;
+        for (pass = 0; pass < 3u; pass++) {
+            trk[0].seq_idx = 40; dream_tick(); trk[0].seq_idx = 0; dream_tick();
+        }
+        ok &= dream.valid && dream.root == 9u && dream.scl == DR_MOOD_SCL[2] && dream.role[0] == DR_DRONE &&
+              dream.role[3] == DR_PERC && piece_ok("A after load");
+        song.playing = 0;
+        scene(0);
+        dream_compose(2);
+        apply_preset_to(&trk[1], 0);
+        ok &= !dream.valid;
+        bad += check("a project loaded after a dream: EVOL works from its own key, chords and parts; a sound load too", ok);
+    }
+    {   /* EVOL over patterns of any scale (after a load, the tracks' own SCL: 5 .. 12 tones): no hang (the alarm), in key */
+        uint32_t scl, pass;
+        alarm(60);
+        for (ok = 1, scl = 0; scl < sizeof SCALE_MASK / sizeof SCALE_MASK[0]; scl++) {
+            scene(0);
+            for (i = 0; i < NTRK; i++)
+                trk[i].p[P_SCALE] = (int16_t)scl;
+            dream.valid = 0;
+            song.g[G_DREAM] = 1;
+            song.g[G_DDRFT] = 8;
+            song.playing = 1;
+            rng_state = scl ? 31u * scl + 7u : 0u;         /* (0: xorshift stuck at 0, every pick the same: no loop) */
+            {
+                static step_t was[NTRK][NSTEP];
+                for (i = 0; i < NTRK; i++)
+                    memcpy(was[i], trk[i].step, sizeof was[i]);
+                for (pass = 0; pass < 40u; pass++) {
+                    trk[0].seq_idx = 40; dream_tick(); trk[0].seq_idx = 0; dream_tick();
+                }
+                for (i = 0; i < NTRK; i++)                 /* what EVOL wrote (the scene's own steps: its key) */
+                    for (k = 0; k < 64u; k++)
+                        for (m = 0; memcmp(&was[i][k], &trk[i].step[k], sizeof(step_t)) &&
+                                    trk[i].step[k].time == ST_NOTE && m < trk[i].step[k].n; m++)
+                            if (!note_ok(trk[i].step[k].note[m])) {
+                                printf("    SCL %u T%u step %u: %u\n", scl, i + 1u, k + 1u, trk[i].step[k].note[m]);
+                                ok = 0;
+                            }
+            }
+            song.playing = 0;
+        }
+        alarm(0);
+        bad += check("EVOL over any SCL (CHR, the pentatonics, the 8-tone ..) and a stuck random: no hang, in that scale", ok);
+    }
+    printf(bad ? "dream: %d FAILED\n" : "dream: all ok\n", bad);
+    return bad != 0;
+}
