+// SPDX-License-Identifier: GPL-3.0-only
+import { createHash } from "node:crypto";
+import { createRequire } from "node:module";
+import { copyFileSync, mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
